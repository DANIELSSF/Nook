---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/island.css';
import '../styles/site.css';
import { t } from '../i18n';
import { config, urls } from '../config';
import { NIGHT, AWAKE_KEY } from '../cat/night';

export interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search results (the demo export routes). */
  noindex?: boolean;
}
const { title = t.meta.title, description = t.meta.description, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = urls.site;
const ogImage = `${config.origin}${base}og.png`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Nook',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS 27 o posterior (Apple Silicon)',
  description,
  url: canonical,
  downloadUrl: urls.download,
  inLanguage: t.lang,
};
---
<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={t.meta.themeColorLight} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={t.meta.themeColorDark} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nook" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.meta.ogAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
    <!-- Sets the visitor's theme and motion choice before first paint, so nothing flashes. A visit that begins at night on a dark
         page begins with the cat asleep: it is marked here (the hours are NIGHT in src/cat/night.ts) so the first paint is right. -->
    <script is:inline define:vars={{ nightFrom: NIGHT.from, nightTo: NIGHT.to, awakeKey: AWAKE_KEY }}>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var th = localStorage.getItem('nook-theme');
          if (th === 'light' || th === 'dark') d.setAttribute('data-theme', th);
          var mo = localStorage.getItem('nook-motion');
          if (mo === 'reduced' || mo === 'full') d.setAttribute('data-motion', mo);
        } catch (e) {}
        if (matchMedia('(prefers-reduced-motion: reduce)').matches && d.getAttribute('data-motion') !== 'full') d.classList.add('is-reduced');
        if (d.getAttribute('data-motion') === 'reduced') d.classList.add('is-reduced');
        if (matchMedia('(hover: none) and (pointer: coarse)').matches) d.classList.add('is-touch');
        try {
          var m = /[?&](?:hora|hour)=(\d{1,2})(?:&|$)/.exec(location.search);
          var hour = m && +m[1] >= 0 && +m[1] <= 23 ? +m[1] : new Date().getHours();
          var set = d.getAttribute('data-theme');
          var dark = set === 'dark' || (set !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
          if ((hour >= nightFrom || hour < nightTo) && dark && sessionStorage.getItem(awakeKey) !== 'awake') d.classList.add('cat-asleep', 'cat-wait');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skip}</a>
    <slot />
  </body>
</html>

# Publishes the site (site/) to GitHub Pages.
#
# To use it: copy this file to .github/workflows/pages.yml, then in the repository go to
# Settings → Pages → Build and deployment → Source: "GitHub Actions".
#
# The site is served from https://<owner>.github.io/<repo>/ . Owner, repo, release asset and base path live in one place,
# site/src/config.ts; change them there if the repository moves or you add a custom domain (then use base: '/').
name: Deploy site to GitHub Pages

on:
  push:
    branches: [main]
    paths:
      - 'site/**'
      - '.github/workflows/pages.yml'
  workflow_dispatch:

# The build runs third-party code (npm ci), so it only reads; the Pages rights belong to the deploy job alone.
permissions:
  contents: read

# GitHub's advice for Pages: let a deployment that started finish.
concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: site
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: site/package-lock.json
      # --ignore-scripts: the site needs no install scripts (ffmpeg-static, used only by `npm run export:demos`, would download a binary).
      - run: npm ci --ignore-scripts
      - run: npm run check
      - run: npm run build
      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v3
        with:
          path: site/dist

  deploy:
    needs: build
    runs-on: ubuntu-latest
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
